# RentHub Server Environment Variables
# Copy this file to .env and fill in your actual values

NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200

# Database (Neon PostgreSQL) — configure in a later phase
DATABASE_URL=

# JWT — configure in a later phase
JWT_SECRET=

# Cloudinary — configure in a later phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

